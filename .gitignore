# Upload source, configuration, documentation, and plain-text results only.
*
!*/
!*.py
!*.sh
!*.md
!*.MD
!*.yaml
!*.yml
!*.json
!*.toml
!*.ini
!*.cfg
!*.txt
!*.csv
!*.tsv
!/.gitignore
!/.gitattributes

# Local dependencies, caches, and generated bytecode stay on disk.
.cache/
.pytest_cache/
.venv/
venv/
__pycache__/
*.py[cod]

# Keep only result-root text files and immediate per-run summaries.
# Do not traverse smoke runs or any nested fold/seed/checkpoint artifacts.
/results/**
!/results/*.csv
!/results/*.tsv
!/results/*.json
!/results/*.txt
!/results/*.md
!/results/*.MD
!/results/runs/
!/results/runs/*.csv
!/results/runs/*/
!/results/runs/*/*.csv
!/results/runs/*/*.tsv
!/results/runs/*/*.json
!/results/runs/*/*.txt
!/results/runs/*/*.md
!/results/runs/*/*.MD

# Never upload fold/seed directories, even outside the normal run layout.
fold-*/
seed-*/
PLAN2*
PLAN2/*